{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Authentication": "Warning",
        "Microsoft.AspNetCore.Authorization": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "service",
              "value": "fintrack"
            }
          ],
          "propertiesAsLabels": ["level"]
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Server={DB_HOST};Port={DB_PORT};Database=FinTrackDb;User Id={DB_USER};password={DB_PASSWORD}"
  },
  "JwtOptions": {
    "Issuer": "http://fintrack.api",
    "Audience": "http://fintrack.api",
    "LifeTime": "00:15:00",
    "RefreshTokenLifeTime": "7.00:00:00"
  },
  "HashicorpVaultOptions": {
    "VaultAddress": "http://localhost:8200",
    "KeyName": "fintrack-api-signing-key",
    "RoleId": ""
  },
  "RedisOptions": {
    "EndPoint": "localhost:6379",
    "DefaultTTL": "00:10:00",
    "CircuitBreakerOptions": {
      "SamplingDuration": "00:00:30",
      "MinimumThroughput": 15,
      "FailureRatio": 0.4,
      "BreakDuration": "00:00:45"

    }
  }
}
