    "/api/auth/token": {
      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Creates access-refresh token pair for user by credentials\nor sends verification code to user email and creates challenge token if 2fa enabled",
        "description": "Request example:\nPOST /api/auth/token\n{\n    \"login\": \"mylogin\",\n    \"password\": \"mypassword\"\n}\n\nResponse example:\n{\n    \"access_token\": \"eyJ...\",\n    \"refresh_token\": \"...\",\n    \"expires_in\": 900\n}\n\nOR\n\nResponse example:\n{\n    \"message\": \"verific ation code was sent to your email\"\n    \"challenge_token\": \"eyJ...\",\n    \"expires_in\": 90,\n    \"_links\": {\n         \"verify\": {\n            \"href\": \"/api/auth/2fa/complete\",\n            \"method\": \"POST\",\n            \"title\": \"verification code confirmation\"\n         },\n         \"resend\": {\n            \"href\": \"/api/auth/2fa/resend\",\n            \"method\": \"POST\",\n            \"title\": \"resend verification code\"\n         }\n    }\n}",
        "requestBody": {
          "description": "user credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "access token created"
          },
          "202": {
            "description": "challenge token created and code was sent to email"
          },
          "401": {
            "description": "provided credentials are invalid or user does not exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "provided credentials are valid, 2fa enabled but email is not verified yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/2fa/complete": {
      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Completes authentication by verification otp code",
        "description": "Request example:\nPOST /api/auth/2fa/complete\n-H \"Authorization: Bearer YOUR_CHALLENGE_TOKEN\"\n{\n    \"code\": 123456\n}\n\nResponse example:\n{\n    \"access_token\": \"eyJ...\",\n    \"refresh_token\": \"...\",\n    \"expires_in\": 900\n}",
        "requestBody": {
          "description": "Verification code",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "access token created"
          },
          "401": {
            "description": "provided code is invalid or user does not exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/2fa/resend": {
      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Sends new verification code to user email",
        "description": "Request example:\nPOST /api/auth/2fa/resend\n-H \"Authorization: Bearer YOUR_CHALLENGE_TOKEN\"\n\nResponse example:\n{\n    \"message\": \"verification code was sent to your email\"\n    \"challenge_token\": \"eyJ...\",\n    \"expires_in\": 90,\n    \"_links\": {\n         \"verify\": {\n            \"href\": \"/api/auth/2fa/complete\",\n            \"method\": \"POST\",\n            \"title\": \"verification code confirmation\"\n         },\n         \"resend\": {\n            \"href\": \"/api/auth/2fa/resend\",\n            \"method\": \"POST\",\n            \"title\": \"resend verification code\"\n         }\n    }\n}",
        "responses": {
          "202": {
            "description": "challenge token created and code was sent to email"
          },
          "401": {
            "description": "provided credentials are invalid or user does not exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/token/refresh": {
      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Creates access-refresh token pair for user by refresh token",
        "description": "Request example:\nPOST /api/auth/token/refresh\n{\n    \"refresh_token\": \"...\" \n}\n\nResponse example:\n{\n    \"access_token\": \"eyJ...\",\n    \"refresh_token\": \"...\",\n    \"expires_in\": 900\n}",
        "requestBody": {
          "description": "valid refresh token",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "token created"
          },
          "401": {
            "description": "provided credentials are invalid or user does not exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/token/revoke": {
      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Revoked a refresh token.\nRequires valid access token",
        "description": "Request example:\nPOST /api/auth/token/revoke\n-H \"Authorization: Bearer YOUR_ACCESS_TOKEN\"\n{\n    \"refresh_token\": \"YOUR_REFRESH_TOKEN\"\n}",
        "requestBody": {
          "description": "valid refresh token",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "token revoked"
          },
          "401": {
            "description": "access or refresh token invalid or does not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/token/status": {
      "get": {
        "tags": [
          "Token"
        ],
        "summary": "Returns status of provided JWT-token",
        "description": "Request example:\nGET /api/auth/token/status\n-H \"Authorization: Bearer YOUR_ACCESS_TOKEN\"",
        "responses": {
          "200": {
            "description": "access token is valid"
          },
          "401": {
            "description": "access token invalid or does not provided",
