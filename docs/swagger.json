        "tags": [
          "Transaction"
        ],
        "summary": "Returns transaction by time interval",
        "description": "Request example:\nGET /api/transactions/interval?start=2025-08-10&end=2025-08-13&page_num=2&page_size=75\n-H \"Authorization: Bearer YOUR_ACCESS_TOKEN\"\n\nResponse example:\n{\n    [    \n        {\n            \"id\": \"30dd879c-ee2f-11db-8314-0800200c9a66\",\n            \"amount\": 300,\n            \"source_account_id\": \"85cb33aa-f7a5-4940-9bf2-7c50850925aa\",\n            \"destination_account_id\": \"3b7c138f-fc68-42b8-a705-31417bb4cb56\",\n        },\n        ...\n    ]\n    \n}",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "description": "start of the interval",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "end of the interval",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page_num",
            "in": "query",
            "description": "page number of the paginated result (default: 1)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "page size of the paginated result, maximum size is 1000 (default: 50)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successfull request"
          },
          "400": {
            "description": "invalid request data",
